    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9",
    "jsdom": "26",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "3.2.4"
  }
