{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEFT",
  "version": "0.1.0",
  "identifier": "com.weft.app",
  "build": {
    "beforeDevCommand": "yarn --cwd weft-frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn --cwd weft-frontend build",
    "frontendDist": "../weft-frontend/dist",
    "features": []
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "WEFT", "width": 1024, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
