{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEFT",
  "version": "0.1.0",
  "identifier": "com.weft.app",
  "build": {
    "beforeBuildCommand": "bash ../scripts/stage-frontend.sh",
    "frontendDist": "../weft_backend/tauri_app/frontend",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "WEFT", "width": 1024, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../weft_backend/tauri_app/icons/icon.png"]
  }
}
